{
  // DayZero deploys as a Cloudflare Worker (API + form backend) with the
  // static generator served from public/ via the ASSETS binding.
  "name": "dayzero",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-23",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  // Uncomment after `wrangler d1 create dayzero` and paste the real id.
  // "d1_databases": [
  //   { "binding": "DB", "database_name": "dayzero", "database_id": "<uuid>" }
  // ],
  "vars": {
    // Optional integrations. Leave empty to run fully offline in capture mode.
    "AI_BASE_URL": "",
    "AI_MODEL": "",
    "EMAIL_PROVIDER": "",
    "EMAIL_FROM": ""
  }
}
